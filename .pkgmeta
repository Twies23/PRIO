# CurseForge / BigWigs packager config.
# Addon source lives at the repo root, so package it INTO a folder named "PRIO"
# (must match the .toc base name so the game loads it).
package-as: PRIO

enable-nolib-creation: no

# Use a hand-written, user-friendly changelog instead of compiling commit
# messages (which would leak author emails / co-author trailers).
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Files that shouldn't ship inside the addon zip.
ignore:
  - .gitignore
  - .pkgmeta
  - branding
  - tests
  - tools
